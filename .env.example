# =============================================================================
# Environment Configuration - MC Pro Website
# =============================================================================

# ---------------------------------------------------------------------------
# Contact Form (Cloudflare Turnstile + own API)
# ---------------------------------------------------------------------------
# 1. Create a Turnstile widget at https://dash.cloudflare.com → Turnstile
#    (domain: mcprogc.com). You get a SITE key (public) and a SECRET key.
# 2. VITE_TURNSTILE_SITE_KEY is PUBLIC — baked into the static bundle.
# 3. TURNSTILE_SECRET_KEY is SECRET — only for the contact-api container.
# Official test keys (always pass): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ---------------------------------------------------------------------------
# SMTP — Google Workspace (office@mcprogc.com)
# ---------------------------------------------------------------------------
# SMTP_PASS is a 16-character App Password (Google Account → Security →
# 2-Step Verification → App passwords), NOT the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=office@mcprogc.com
SMTP_PASS=your_gmail_app_password

# Where contact form messages are delivered.
MAIL_TO=office@mcprogc.com
MAIL_FROM=office@mcprogc.com

# ---------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# ---------------------------------------------------------------------------
# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
GTM_CONTAINER_ID=GTM-XXXXXXX

# ---------------------------------------------------------------------------
# Monitoring & Logging (Optional)
# ---------------------------------------------------------------------------
# Sentry for error tracking
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Docker Settings
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=summit-website
DOCKER_DEFAULT_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Nginx Settings
# ---------------------------------------------------------------------------
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
