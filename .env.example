# =============================================================================
# Environment Configuration - Summit Commercial Construction Website
# =============================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
NODE_ENV=production
SITE_URL=https://summitcommercial-il.com

# ---------------------------------------------------------------------------
# Contact Form (Web3Forms + hCaptcha)
# ---------------------------------------------------------------------------
# 1. Create an access key at https://web3forms.com using office@mcprogc.com
#    (submissions are delivered to that inbox; no backend needed).
# 2. Spam protection: hCaptcha — verified server-side by Web3Forms on the
#    FREE plan via their shared site key (50b2fe65-...). No keys needed here.
#    Optional: enable hCaptcha as required in https://app.web3forms.com.
# The access key is PUBLIC (site-side) and baked into the static bundle at build time.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# ---------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# ---------------------------------------------------------------------------
# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
GTM_CONTAINER_ID=GTM-XXXXXXX

# ---------------------------------------------------------------------------
# Monitoring & Logging (Optional)
# ---------------------------------------------------------------------------
# Sentry for error tracking
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Database (Future API Implementation)
# ---------------------------------------------------------------------------
# PostgreSQL or MySQL for contact form storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=summit_website
DB_USER=db_user
DB_PASS=secure_password

# ---------------------------------------------------------------------------
# Redis (Optional - for rate limiting & caching)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ---------------------------------------------------------------------------
# Security Settings
# ---------------------------------------------------------------------------
# JWT Secret for API authentication (if implementing backend)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Docker Settings
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=summit-website
DOCKER_DEFAULT_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Nginx Settings
# ---------------------------------------------------------------------------
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ---------------------------------------------------------------------------
# SSL/TLS Certificate Paths (for manual SSL configuration)
# ---------------------------------------------------------------------------
SSL_CERT_PATH=/etc/letsencrypt/live/summitcommercial-il.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/summitcommercial-il.com/privkey.pem
