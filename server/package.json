{
  "name": "mc-pro-contact-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Contact form API for mcprogc.com — Cloudflare Turnstile verification + SMTP delivery",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^7.0.10",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
